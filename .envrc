#!/usr/bin/env bash

# Cold Nix store evals can exceed 20s; 60s avoids false warnings on first clone.
export DIRENV_WARN_TIMEOUT=60s

# Nix 2.34 rejects client-specified restricted settings from untrusted users.
# devenv currently passes settings such as `system` while evaluating the shell,
# which makes `use devenv` fail unless this user is listed in trusted-users.
# Prefer the real devenv integration when possible; otherwise fall back to an
# equivalent nix-shell environment plus script shims for the commands below.
_devd_user_is_nix_trusted() {
  local user group trusted
  user=$(id -un)
  group=$(id -gn)
  trusted=$(nix config show trusted-users 2>/dev/null || true)
  [[ " $trusted " == *" $user "* || " $trusted " == *" @$group "* || " $trusted " == *" @admin "* ]]
}

_devd_use_fallback_shell() {
  echo "WARN devenv is unavailable for untrusted Nix user '$(id -un)'; using nix-shell fallback"
  echo "WARN preferred system fix: add '$(id -un)' to trusted-users in /etc/nix/nix.conf and restart nix-daemon"

  use nix -p e2fsprogs go golangci-lint jujutsu openssh

  export CGO_ENABLED=0
  export GOBIN="$PWD/bin"
  PATH_add "$PWD/bin"

  local script_dir="$PWD/.direnv/devd-scripts"
  mkdir -p "$script_dir"
  PATH_add "$script_dir"

  cat >"$script_dir/build" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "Building devd..."
go build -o bin/devd ./cmd/devd
echo "Built bin/devd"
EOF

  cat >"$script_dir/test" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "Running tests..."
go test ./...
EOF

  cat >"$script_dir/lint" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "Linting..."
golangci-lint run ./...
EOF

  cat >"$script_dir/check" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "Running all checks (gofmt, vet, lint, test)..."
echo ""

echo "==> gofmt"
bad=$(find . -name '*.go' -not -path './.devenv/*' -not -path './vendor/*' | xargs gofmt -l 2>&1) || true
if [ -n "$bad" ]; then
  echo "FAIL: gofmt found unformatted files:"
  echo "$bad"
  exit 1
fi
echo "    ok"
echo ""

echo "==> go vet"
go vet ./...
echo "    ok"
echo ""

echo "==> golangci-lint"
golangci-lint run ./...
echo "    ok"
echo ""

echo "==> go test"
go test ./...
echo "    ok"
echo ""

echo "All checks passed."
EOF

  cat >"$script_dir/setup" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "Downloading Go modules..."
go mod download
echo "Done."
EOF

  cat >"$script_dir/clean" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
rm -rf bin/
echo "Cleaned."
EOF

  cat >"$script_dir/setup-jj" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if jj root &>/dev/null; then
  echo "jj is already initialized: $(jj root)"
  exit 0
fi
if [ ! -d .git ]; then
  echo "ERROR: .git not found; clone this repo first, then run setup-jj"
  exit 1
fi

echo "Initializing colocated jj repo..."
jj git init --colocate

if jj bookmark list --remote origin 2>/dev/null | grep -q '^main@origin:'; then
  jj bookmark track main --remote=origin 2>/dev/null || true
fi

echo "Done. Use: jj st, jj log -r 'all()'"
EOF

  ln -sf "$PWD/scripts/install-krunvm" "$script_dir/install-krunvm"

  chmod +x "$script_dir"/*

  echo "devd dev shell"
  echo "  build  — go build -o bin/devd ./cmd/devd"
  echo "  test   — go test ./..."
  echo "  lint   — golangci-lint run"
  echo "  check  — gofmt + vet + lint + test (pre-commit substitute for jj)"
  echo "  setup  — go mod download"
  echo "  setup-jj — initialize jj after a plain git clone"
  echo "  clean  — rm -rf bin/"
  echo "  install-krunvm — install krunvm (macOS: brew, Fedora: dnf)"
  echo ""
  go version
  jj version 2>/dev/null || true

  if [ -d .git ] && [ ! -d .jj ]; then
    echo ""
    echo "INFO this repo uses jj. Run: setup-jj"
  fi

  if ! command -v krunvm &>/dev/null; then
    echo ""
    echo "WARNING: krunvm not found."
    echo "  devd shells out to krunvm for VM lifecycle."
    echo "  Run: install-krunvm"
    echo "  See: https://github.com/containers/krunvm"
  fi
}

if _devd_user_is_nix_trusted; then
  eval "$(devenv direnvrc)"

  # `use devenv` supports the same options as the `devenv shell` command.
  #
  # To silence all output, use `--quiet`.
  #
  # Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
  use devenv || _devd_use_fallback_shell
else
  _devd_use_fallback_shell
fi
