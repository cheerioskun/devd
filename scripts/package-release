#!/usr/bin/env bash
# Build a release archive on the target host. devd-vm links against the host
# libkrun and cannot be cross-compiled by GoReleaser.

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=${1:-}
[[ -n "$version" ]] || { echo "usage: scripts/package-release <version>" >&2; exit 2; }
[[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || {
  echo "ERROR: invalid release version: $version" >&2
  exit 2
}

case $(uname -s) in
  Darwin) platform=Darwin ;;
  Linux) platform=Linux ;;
  *) echo "ERROR: unsupported release platform: $(uname -s)" >&2; exit 1 ;;
esac
case $(uname -m) in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x86_64 ;;
  *) echo "ERROR: unsupported release architecture: $(uname -m)" >&2; exit 1 ;;
esac

name="devd_${version}_${platform}_${arch}"
stage="$root/dist/$name"
archive="$root/dist/$name.tar.gz"
rm -rf "$stage" "$archive" "$archive.sha256"
mkdir -p "$stage"

(
  cd "$root"
  CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X devd/internal/cli.version=$version" \
    -o "$stage/devd" ./cmd/devd
  scripts/build-runtime "$stage"
)
cp "$root/LICENSE" "$stage/LICENSE"

"$stage/devd" version
case $platform in
  Darwin)
    [[ $(file "$stage/devd-vm") == *"Mach-O 64-bit $arch executable"* ]] || {
      echo "ERROR: devd-vm has the wrong architecture" >&2
      exit 1
    }
    codesign --verify --strict "$stage/devd-vm"
    ;;
  Linux)
    [[ $(file "$stage/devd-vm") == *"ELF 64-bit"* ]] || {
      echo "ERROR: devd-vm is not an ELF executable" >&2
      exit 1
    }
    ;;
esac
[[ $(file "$stage/devd-image-helper") == *"ELF 64-bit"* ]] || {
  echo "ERROR: devd-image-helper is not a Linux ELF executable" >&2
  exit 1
}

tar -C "$stage" -czf "$archive" devd devd-vm devd-image-helper LICENSE
(
  cd "$root/dist"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$(basename "$archive")" >"$(basename "$archive").sha256"
  else
    sha256sum "$(basename "$archive")" >"$(basename "$archive").sha256"
  fi
)
rm -rf "$stage"
printf 'Created %s\nCreated %s\n' "$archive" "$archive.sha256"
