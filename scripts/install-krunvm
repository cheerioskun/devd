#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname)" == "Darwin" ]]; then
  if ! command -v krunvm &>/dev/null; then
    echo "Installing krunvm via Homebrew..."
    brew tap libkrun/krun
    brew trust libkrun/krun
    # The tap currently infers libkrunfw's version as "64" from its
    # aarch64 source filename, so Homebrew requests a nonexistent bottle.
    # Install that dependency from source until the upstream formula is fixed.
    brew install --build-from-source libkrun/krun/libkrunfw
    brew install libkrun/krun/krunvm
  else
    echo "krunvm already installed: $(krunvm --version)"
  fi

  # buildah's VFS storage needs a case-sensitive filesystem on macOS.
  # APFS volumes share their container's free space and are non-destructive.
  if [[ ! -d /Volumes/krunvm ]]; then
    data_device="$(diskutil info /System/Volumes/Data | awk '/Device Identifier/ { print $3; exit }')"
    container="$(printf '%s' "$data_device" | sed -E 's/s[0-9]+$//')"
    if [[ -z "$container" ]]; then
      echo "ERROR: Could not determine the APFS container for the data volume"
      exit 1
    fi
    echo "Creating case-sensitive APFS volume at /Volumes/krunvm..."
    diskutil apfs addVolume "$container" "Case-sensitive APFS" krunvm
  fi

  krunvm_config="$HOME/Library/Preferences/rs.krunvm/krunvm.toml"
  if [[ ! -f "$krunvm_config" ]] || ! grep -Eq "^storage_volume = ['\"][^'\"]+['\"]$" "$krunvm_config"; then
    echo "Configuring krunvm storage at /Volumes/krunvm..."
    # krunvm exits with 255 after saving its initial configuration.
    printf '\n' | krunvm list || true
    if [[ ! -f "$krunvm_config" ]] || ! grep -Eq "^storage_volume = ['\"][^'\"]+['\"]$" "$krunvm_config"; then
      echo "ERROR: krunvm storage configuration failed"
      exit 1
    fi
  fi
elif command -v krunvm &>/dev/null; then
  echo "krunvm already installed: $(krunvm --version)"
elif command -v dnf &>/dev/null; then
  echo "Installing krunvm via DNF (Fedora COPR)..."
  sudo dnf copr enable -y slp/krunvm
  sudo dnf install -y krunvm
else
  echo "Manual install required. See: https://github.com/containers/krunvm"
  exit 1
fi
